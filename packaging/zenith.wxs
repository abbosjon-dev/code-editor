<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows installer (WiX v4/v5). Built by packaging/package.sh:
     wix build packaging/zenith.wxs -arch x64 -d Version=0.1.0 -d ExePath=... -d IconPath=... -d LicensePath=... -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Zenith"
           Manufacturer="Zenith"
           Version="$(var.Version)"
           UpgradeCode="6f1c2a4e-8d3b-4f7a-9c21-5e0b7d4a3c19"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Zenith — fast, extensible, AI-native code editor" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Zenith is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ZenithIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ZenithIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/abbosjon-dev/code-editor" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Zenith">
        <Component Id="MainExecutable">
          <File Id="ZenithExe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
        <Component Id="LicenseFile">
          <File Id="LicenseTxt" Source="$(var.LicensePath)" Name="LICENSE.txt" />
        </Component>
        <!-- Let `zenith` work from any terminal. -->
        <Component Id="PathEntry" Guid="3d0f6a2b-9e41-4c8d-a7b5-1f2e3c4d5a6b">
          <Environment Id="ZenithPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
          <RegistryValue Root="HKLM" Key="Software\Zenith" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="8b2e4c6d-1a3f-4e5b-9c7d-2f4a6b8c0d1e">
        <Shortcut Id="ZenithStartMenu"
                  Name="Zenith"
                  Description="Code editor"
                  Target="[INSTALLFOLDER]zenith.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ZenithIcon" />
        <RegistryValue Root="HKCU" Key="Software\Zenith" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Zenith" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
